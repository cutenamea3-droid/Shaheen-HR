# Copy to .env for local builds. Production builds also load committed `.env.production`
# (publishable/anon keys only). On Cloudflare Pages you may override the same names under
# Settings → Environment variables (Production + Preview), available at Build time.
# Vite inlines VITE_* into the client bundle during `bun run build` / `npm run build`.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# VITE_SUPABASE_PROJECT_ID=

# Optional aliases used by SSR tooling / Lovable; not required for the static SPA deploy.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Local visual preview only (never set on Cloudflare / .env.production):
#   VITE_PREVIEW_ISOLATED=1
#   VITE_SUPABASE_URL=http://127.0.0.1:9
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_isolated_preview_only
# Or run: bash scripts/preview-isolated.sh

# Driver Rate Cards — keep OFF until migration 20261106140000_driver_rate_cards_secure.sql
# is approved and applied on Driver Supabase. Default is mock (session memory only).
# VITE_DRIVER_RATE_CARD_SECURE=1

# Driver Drug Test register — enable ONLY after migration 20261106140100_driver_drug_tests_secure.sql
# is applied on Driver Supabase (okzcwctsgurumnnzuxgg). When off, UI disables saving
# (no mock/localStorage fallback as a real save). Set on Cloudflare Pages Build env
# (Preview and/or Production) then redeploy — do not commit this as 1 in .env.production.
# VITE_DRIVER_DRUG_TESTS_SECURE=1

# Dispatch Operations — reuses company Driver Supabase URL/key by default with isolated
# dispatch_* tables + shaheen-dispatch-auth-v1 session storage. Apply
# supabase/migrations/20261113170000_dispatch_operations.sql and deploy
# supabase/functions/create-dispatch-user ONLY after owner approval (not Production by default).
# Optional overrides if Dispatch ever moves to a dedicated project:
# VITE_DISPATCH_SUPABASE_URL=
# VITE_DISPATCH_SUPABASE_PUBLISHABLE_KEY=
